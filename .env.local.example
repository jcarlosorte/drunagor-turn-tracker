# Copia este archivo a .env.local y rellena con la config de tu app Web en Firebase.
# Guía paso a paso: docs/probar-guardado.md → sección "Crear Firebase paso a paso"
#
# Firebase Console → Project settings → Your apps → Web → Config
# No subas .env.local al repositorio.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
